# Large artifacts
*.pth
outputs/

# Corpora are large and, depending on the source, not ours to redistribute.
# The provenance sidecars are neither: they are a few hundred bytes and they
# are the record of where the data came from, so they are committed.
datasets/*.csv
!datasets/*.provenance.json
